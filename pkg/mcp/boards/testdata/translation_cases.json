    "now": "2026-09-23T15:04:05Z",
    "params": {
      "duration": "day",
      "filter": [{"filterConfigurationKey": "workflow", "id": "1", "operator": "contains", "value": "api-"}]
    },
    "endpoint": "/insights/workflows",
    "query": {"startDate": "2026-09-23T00:00:00Z", "endDate": "2026-09-24T00:00:00Z", "workflow": "~api-"}
  },
