  {
    "name": "environment, labels, tags and status filters",
    "kind": "workflows",
    "now": "2026-09-23T15:04:05Z",
    "params": {
      "duration": "day",
      "filter": [
        {"filterConfigurationKey": "environment", "id": "1", "operator": "is", "value": ["tkcenv_a", "tkcenv_b"]},
        {"filterConfigurationKey": "status", "id": "2", "operator": "is", "value": ["passed", "failed"]},
        {"filterConfigurationKey": "labels-v2", "id": "3", "operator": "is", "value": ["team=core"]},
        {"filterConfigurationKey": "labels-v2", "id": "4", "operator": "where", "value": {"labelKey": "tier", "labelOperator": "contains", "labelValue": "gold"}},
        {"filterConfigurationKey": "labels-v2", "id": "5", "operator": "where", "value": {"labelKey": "owner", "labelOperator": "exists"}},
        {"filterConfigurationKey": "tags", "id": "6", "operator": "is", "value": ["release=1.2,hotfix"]}
      ]
    },
    "endpoint": "/insights/workflows",
    "query": {
      "startDate": "2026-09-23T00:00:00Z",
      "endDate": "2026-09-24T00:00:00Z",
      "env": "tkcenv_a,tkcenv_b",
      "status": "passed,failed",
      "selector": "team=core,tier=~gold,owner",
      "tagFilter": "[\"release=1.2,hotfix\"]"
    }
  },
  {
    "name": "a contains string filter becomes a regex",
