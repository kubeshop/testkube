{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Projects under test/ are fixtures with pinned framework versions, not product dependencies.",
      "matchFileNames": [
        "**/test/**",
        "**/tests/**"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/new-build.yaml"
      ],
      "matchStrings": [
        "MCP_PUBLISHER_VERSION:\\s*(?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "modelcontextprotocol/registry"
    }
  ]
}
